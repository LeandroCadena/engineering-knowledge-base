{
  "openapi": "3.1.1",
  "info": {
    "title": "Orders REST and OpenAPI example",
    "version": "1.0.0",
    "description": "Bounded in-memory fixture. Bearer demo-token is a test credential, not a production identity system."
  },
  "servers": [
    {
      "url": "http://localhost:3004"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/orders": {
      "get": {
        "operationId": "listOrders",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 2
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Orders sorted by ascending fixture ID; no snapshot guarantee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderPage"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      },
      "post": {
        "operationId": "createOrder",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Order created or an equivalent request replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                },
                "example": {
                  "id": "ord_000001",
                  "sku": "book",
                  "quantity": 2,
                  "status": "open",
                  "links": {
                    "self": "/orders/ord_000001",
                    "cancel": "/orders/ord_000001/cancellations"
                  }
                }
              }
            },
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            },
            "links": {
              "getCreatedOrder": {
                "operationId": "getOrder",
                "parameters": {
                  "orderId": "$response.body#/id"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrder"
              }
            }
          }
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ord_[0-9]{6}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current order representation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/orders/{orderId}/cancellations": {
      "post": {
        "operationId": "cancelOrder",
        "parameters": [
          {
            "name": "orderId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ord_[0-9]{6}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Cancellation created or an equivalent request replayed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            },
            "headers": {
              "Location": {
                "required": true,
                "schema": {
                  "type": "string",
                  "format": "uri-reference"
                }
              }
            },
            "links": {
              "getCancellation": {
                "operationId": "getCancellation",
                "parameters": {
                  "cancellationId": "$response.body#/id"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CancelOrder"
              }
            }
          }
        }
      }
    },
    "/cancellations/{cancellationId}": {
      "get": {
        "operationId": "getCancellation",
        "parameters": [
          {
            "name": "cancellationId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^can_[0-9]{6}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Completed cancellation",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Cancellation"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Problem"
          },
          "401": {
            "$ref": "#/components/responses/Problem"
          },
          "404": {
            "$ref": "#/components/responses/Problem"
          },
          "409": {
            "$ref": "#/components/responses/Problem"
          },
          "413": {
            "$ref": "#/components/responses/Problem"
          },
          "415": {
            "$ref": "#/components/responses/Problem"
          },
          "500": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "The fixture accepts only demo-token."
      }
    },
    "schemas": {
      "CreateOrder": {
        "type": "object",
        "required": ["sku", "quantity"],
        "additionalProperties": false,
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": ".*\\S.*"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "note": {
            "type": ["string", "null"],
            "maxLength": 120
          }
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "sku", "quantity", "status", "links"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ord_[0-9]{6}$"
          },
          "sku": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": ".*\\S.*"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "note": {
            "type": ["string", "null"],
            "maxLength": 120
          },
          "status": {
            "type": "string",
            "enum": ["open", "cancelled"]
          },
          "links": {
            "type": "object",
            "required": ["self"],
            "additionalProperties": false,
            "properties": {
              "self": {
                "type": "string",
                "format": "uri-reference"
              },
              "cancel": {
                "type": "string",
                "format": "uri-reference"
              }
            }
          }
        }
      },
      "CancelOrder": {
        "type": "object",
        "required": ["reason"],
        "additionalProperties": false,
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": ".*\\S.*"
          }
        }
      },
      "Cancellation": {
        "type": "object",
        "required": ["id", "orderId", "reason", "status", "links"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^can_[0-9]{6}$"
          },
          "orderId": {
            "type": "string",
            "pattern": "^ord_[0-9]{6}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": ".*\\S.*"
          },
          "status": {
            "const": "completed"
          },
          "links": {
            "type": "object",
            "required": ["self", "order"],
            "additionalProperties": false,
            "properties": {
              "self": {
                "type": "string",
                "format": "uri-reference"
              },
              "order": {
                "type": "string",
                "format": "uri-reference"
              }
            }
          }
        }
      },
      "OrderPage": {
        "type": "object",
        "required": ["items", "links"],
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "links": {
            "type": "object",
            "required": ["self"],
            "additionalProperties": false,
            "properties": {
              "self": {
                "type": "string",
                "format": "uri-reference"
              },
              "next": {
                "type": "string",
                "format": "uri-reference"
              }
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": ["type", "title", "status", "detail", "instance", "code"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "format": "uri-reference"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri-reference"
          },
          "code": {
            "type": "string",
            "enum": [
              "INVALID_REQUEST",
              "UNAUTHENTICATED",
              "NOT_FOUND",
              "CONFLICT",
              "INTERNAL_ERROR"
            ]
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Machine-readable request or server failure",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    }
  }
}

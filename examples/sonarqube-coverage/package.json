{
  "name": "sonarqube-coverage-example",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "coverage": "c8 --all --include='src/**/*.mjs' --reporter=lcov --reporter=text --check-coverage --lines=100 --branches=100 --functions=100 --statements=100 node --test test/*.test.mjs",
    "verify:report": "node scripts/verify-report.mjs"
  },
  "devDependencies": {
    "c8": "12.0.0"
  }
}
